#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "mnt" "a" "first-league" "regular-season"
${CURL} ${SW}/montenegro/first-league/20172018/regular-season/r42405/matches/ > ${DIR}/mnt/a.html

printf " %-3s > %-3s > %s > %s\n" "mnt" "b" "second-league" "regular-season"
${CURL} ${SW}/montenegro/second-league/20172018/regular-season/r42566/matches/ > ${DIR}/mnt/b.html

