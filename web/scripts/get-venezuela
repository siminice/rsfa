#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "ven" "a" "primera-division" "apertura"
${CURL} ${SW}/venezuela/primera-division/2018/apertura/r45787/matches/ > ${DIR}/ven/a.html

#printf " %-3s > %-3s > %s > %s\n" "ven" "a" "primera-division" "clausura"
#${CURL} ${SW}/venezuela/primera-division/2018/clausura/r45792/matches/ > ${DIR}/ven/a.html

printf " %-3s > %-3s > %s > %s\n" "ven" "b1" "segunda-division" "apertura"
${CURL} ${SW}/venezuela/segunda-division/2018/championship---final/r46117/matches/ > ${DIR}/ven/b1.html

