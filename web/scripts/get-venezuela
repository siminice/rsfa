#!/bin/bash

CURL="curl -s --get"
SW="http://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "ven" "a" "primera-division" "clausura"
${CURL} ${SW}/venezuela/primera-division/2017/clausura/r39814/matches/ > ${DIR}/ven/a.html

printf " %-3s > %-3s > %s > %s\n" "ven" "b" "segunda-division" "promotion-round"
${CURL} ${SW}/venezuela/segunda-division/2017/promotion-round/r39715/matches/ > ${DIR}/ven/b.html
