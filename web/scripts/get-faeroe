#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "fae" "a" "meistaradeildin" "regular-season"
${CURL} ${SW}/faroe-islands/meistaradeildin/2018/regular-season/r44303/matches/ > ${DIR}/fae/a.html

printf " %-3s > %-3s > %s > %s\n" "fae" "b" "1-deild" "regular-season"
${CURL} ${SW}/faroe-islands/1-deild/2018/regular-season/r44304/matches/ > ${DIR}/fae/b.html

printf " %-3s > %-3s > %s > %s\n" "fae" "c" "2-deild" "regular-season"
${CURL} ${SW}/faroe-islands/2-deild/2018/regular-season/r43854/matches/ > ${DIR}/fae/c.html

