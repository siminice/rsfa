#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "kaz" "a" "premier-league" "regular-season"
${CURL} ${SW}/kazakhstan/premier-league/2018/regular-season/r44925/matches/ > ${DIR}/kaz/a.html

printf " %-3s > %-3s > %s > %s\n" "kaz" "b" "1-division" "regular-season"
${CURL} ${SW}/kazakhstan/1-division/2018/regular-season/r43401/matches/ > ${DIR}/kaz/b.html

