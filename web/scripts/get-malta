#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "mal" "a" "premier-league" "regular-season"
${CURL} ${SW}/malta/premier-league/20172018/regular-season/r41154/matches/ > ${DIR}/mal/a.html

printf " %-3s > %-3s > %s > %s\n" "mal" "b" "first-division" "regular-season"
${CURL} ${SW}/malta/first-division/20172018/regular-season/r40876/matches/ > ${DIR}/mal/b.html

printf " %-3s > %-3s > %s > %s\n" "mal" "c" "second-division" "regular-season"
${CURL} ${SW}/malta/second-division/20172018/regular-season/r40731/matches/ > ${DIR}/mal/c.html

