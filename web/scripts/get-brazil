#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "bra" "l24" "paulista-a1" "regular-season"
${CURL} ${SW}/brazil/paulista-a1/2018/regular-season/r41231/matches/ > ${DIR}/bra/l24.html

printf " %-3s > %-3s > %s > %s\n" "bra" "l23" "carioca-1" "taca-rio"
${CURL} ${SW}/brazil/carioca-1/2018/taca-rio/r41202/matches/ > ${DIR}/bra/l23.html

printf " %-3s > %-3s > %s > %s\n" "bra" "l26" "gaucho-1" "regular-season"
${CURL} ${SW}/brazil/gaucho-1/2018/regular-season/r41216/matches/ > ${DIR}/bra/l26.html

printf " %-3s > %-3s > %s > %s\n" "bra" "l22" "mineiro-1" "regular-season"
${CURL} ${SW}/brazil/mineiro-1/2018/regular-season/r41245/matches/ > ${DIR}/bra/l22.html

