#!/bin/bash

CURL="curl -s --get"
SW="http://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "isl" "a" "urvalsdeild" "regular-season"
${CURL} ${SW}/iceland/urvalsdeild/2017/regular-season/r39085/matches/ > ${DIR}/isl/a.html

printf " %-3s > %-3s > %s > %s\n" "isl" "b" "1-deild" "regular-season"
${CURL} ${SW}/iceland/1-deild/2017/regular-season/r38915/matches/ > ${DIR}/isl/b.html

printf " %-3s > %-3s > %s > %s\n" "isl" "c" "2-deild" "regular-season"
${CURL} ${SW}/iceland/2-deild/2017/regular-season/r38914/matches/ > ${DIR}/isl/c.html

printf " %-3s > %-3s > %s > %s\n" "isl" "d" "3-deild" "regular-season"
${CURL} ${SW}/iceland/3-deild/2017/regular-season/r38871/matches/ > ${DIR}/isl/d.html

