#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "isl" "a" "urvalsdeild" "regular-season"
${CURL} ${SW}/iceland/urvalsdeild/2018/regular-season/r44141/matches/ > ${DIR}/isl/a.html

printf " %-3s > %-3s > %s > %s\n" "isl" "b" "1-deild" "regular-season"
${CURL} ${SW}/iceland/1-deild/2018/regular-season/r44113/matches/ > ${DIR}/isl/b.html

printf " %-3s > %-3s > %s > %s\n" "isl" "c" "2-deild" "regular-season"
${CURL} ${SW}/iceland/2-deild/2018/regular-season/r43694/matches/ > ${DIR}/isl/c.html

printf " %-3s > %-3s > %s > %s\n" "isl" "d" "3-deild" "regular-season"
${CURL} ${SW}/iceland/3-deild/2018/regular-season/r43561/matches/ > ${DIR}/isl/d.html

