#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "arm" "a" "premier-league" "regular-season"
${CURL} ${SW}/armenia/premier-league/20172018/regular-season/r42191/matches/ > ${DIR}/arm/a.html

printf " %-3s > %-3s > %s > %s\n" "arm" "b" "first-league" "regular-season"
${CURL} ${SW}/armenia/first-league/20172018/regular-season/r42141/matches/ > ${DIR}/arm/b.html

