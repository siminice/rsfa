#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "por" "a" "portuguese-liga-" "regular-season"
${CURL} ${SW}/portugal/portuguese-liga-/20172018/regular-season/r41648/matches/ > ${DIR}/por/a.html

printf " %-3s > %-3s > %s > %s\n" "por" "b" "liga-de-honra" "regular-season"
${CURL} ${SW}/portugal/liga-de-honra/20172018/regular-season/r41510/matches/ > ${DIR}/por/b.html

printf " %-3s > %-3s > %s > %s\n" "por" "c1" "ii-divisao" "group-a"
${CURL} ${SW}/portugal/ii-divisao/20172018/group-a/r42800/matches/ > ${DIR}/por/c1.html

printf " %-3s > %-3s > %s > %s\n" "por" "c2" "ii-divisao" "group-b"
${CURL} ${SW}/portugal/ii-divisao/20172018/group-b/r42802/matches/ > ${DIR}/por/c2.html

printf " %-3s > %-3s > %s > %s\n" "por" "c3" "ii-divisao" "group-c"
${CURL} ${SW}/portugal/ii-divisao/20172018/group-c/r42804/matches/ > ${DIR}/por/c3.html

printf " %-3s > %-3s > %s > %s\n" "por" "c4" "ii-divisao" "group-d"
${CURL} ${SW}/portugal/ii-divisao/20172018/group-d/r42806/matches/ > ${DIR}/por/c4.html

printf " %-3s > %-3s > %s > %s\n" "por" "c5" "ii-divisao" "group-e"
${CURL} ${SW}/portugal/ii-divisao/20172018/group-e/r42808/matches/ > ${DIR}/por/c5.html
