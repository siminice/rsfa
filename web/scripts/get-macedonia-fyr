#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "mac" "a" "first-league" "regular-season"
${CURL} ${SW}/macedonia-fyr/first-league/20172018/regular-season/r42190/matches/ > ${DIR}/mac/a.html

printf " %-3s > %-3s > %s > %s\n" "mac" "b1" "second-league" "regular-season"
${CURL} ${SW}/macedonia-fyr/second-league/20172018/regular-season/r42014/matches/ > ${DIR}/mac/b1.html

printf " %-3s > %-3s > %s > %s\n" "mac" "b2" "second-league" "west"
${CURL} ${SW}/macedonia-fyr/second-league/20172018/west/r42938/matches/ > ${DIR}/mac/b2.html

