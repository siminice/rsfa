#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "ecu" "a" "primera-a" "1st-phase"
${CURL} ${SW}/ecuador/primera-a/2018/1st-phase/r45796/matches/ > ${DIR}/ecu/a.html

#printf " %-3s > %-3s > %s > %s\n" "ecu" "a" "primera-a" "2nd-phase"
#${CURL} ${SW}/ecuador/primera-a/2018/2nd-phase/r45797/matches/ > ${DIR}/ecu/a.html

printf " %-3s > %-3s > %s > %s\n" "ecu" "b" "primera-b" "regular-season"
${CURL} ${SW}/ecuador/primera-b/2018/regular-season/r45568/matches/ > ${DIR}/ecu/b.html

