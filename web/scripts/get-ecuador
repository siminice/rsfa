#!/bin/bash

CURL="curl -s --get"
SW="http://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "ecu" "a" "primera-a" "2nd-phase"
${CURL} ${SW}/ecuador/primera-a/2017/2nd-phase/r39822/matches/ > ${DIR}/ecu/a.html

printf " %-3s > %-3s > %s > %s\n" "ecu" "b" "primera-b" "regular-season"
${CURL} ${SW}/ecuador/primera-b/2017/regular-season/r39785/matches/ > ${DIR}/ecu/b.html

