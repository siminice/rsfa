#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "par" "a" "division-profesional" "apertura"
${CURL} ${SW}/paraguay/division-profesional/2018/apertura/r45776/matches/ > ${DIR}/par/a.html

#printf " %-3s > %-3s > %s > %s\n" "par" "a" "division-profesional" "clausura"
#${CURL} ${SW}/paraguay/division-profesional/2018/clausura/r45777/matches/ > ${DIR}/par/a.html

printf " %-3s > %-3s > %s > %s\n" "par" "b" "division-intermedia" "regular-season"
${CURL} ${SW}/paraguay/division-intermedia/2018/regular-season/r43699/matches/ > ${DIR}/par/b.html

