#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "blr" "a" "premier-league" "regular-season"
${CURL} ${SW}/belarus/premier-league/2018/regular-season/r45312/matches/ > ${DIR}/blr/a.html

printf " %-3s > %-3s > %s > %s\n" "blr" "b" "1-division" "regular-season"
${CURL} ${SW}/belarus/1-division/2018/regular-season/r44927/matches/ > ${DIR}/blr/b.html

printf " %-3s > %-3s > %s > %s\n" "blr" "c" "2-division" "regular-season"
${CURL} ${SW}/belarus/2-division/2018/regular-season/r45905/matches/ > ${DIR}/blr/c.html

