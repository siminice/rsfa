#!/bin/bash

CURL="curl -s --get"
SW="http://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "gre" "a" "super-league" "regular-season"
${CURL} ${SW}/greece/super-league/20162017/regular-season/r36670/matches/ > ${DIR}/gre/a.html

printf " %-3s > %-3s > %s > %s\n" "gre" "b" "football-league" "regular-season"
${CURL} ${SW}/greece/football-league/20162017/regular-season/r38508/matches/ > ${DIR}/gre/b.html

printf " %-3s > %-3s > %s > %s\n" "gre" "c1" "football-league-2" "group-a"
${CURL} ${SW}/greece/football-league-2/20162017/group-a/r36167/matches/ > ${DIR}/gre/c1.html

printf " %-3s > %-3s > %s > %s\n" "gre" "c2" "football-league-2" "group-b"
${CURL} ${SW}/greece/football-league-2/20162017/group-b/r36168/matches/ > ${DIR}/gre/c2.html

printf " %-3s > %-3s > %s > %s\n" "gre" "c3" "football-league-2" "group-c"
${CURL} ${SW}/greece/football-league-2/20162017/group-c/r36169/matches/ > ${DIR}/gre/c3.html

printf " %-3s > %-3s > %s > %s\n" "gre" "c4" "football-league-2" "group-d"
${CURL} ${SW}/greece/football-league-2/20162017/group-d/r36170/matches/ > ${DIR}/gre/c4.html

