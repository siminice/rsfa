#!/bin/bash

CURL="curl -s --get"
SW="http://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "nor" "a" "eliteserien" "regular-season"
${CURL} ${SW}/norway/eliteserien/2017/regular-season/r39484/matches/ > ${DIR}/nor/a.html

printf " %-3s > %-3s > %s > %s\n" "nor" "b" "1-division" "regular-season"
${CURL} ${SW}/norway/1-division/2017/regular-season/r39625/matches/ > ${DIR}/nor/b.html

printf " %-3s > %-3s > %s > %s\n" "nor" "c1" "2-divisjon" "group-1"
${CURL} ${SW}/norway/2-divisjon/2017/group-1/r39158/matches/ > ${DIR}/nor/c1.html

printf " %-3s > %-3s > %s > %s\n" "nor" "c2" "2-divisjon" "group-2"
${CURL} ${SW}/norway/2-divisjon/2017/group-2/r39159/matches/ > ${DIR}/nor/c2.html

