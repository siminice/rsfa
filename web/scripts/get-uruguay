#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "uru" "a" "primera-division" "apertura"
${CURL} ${SW}/uruguay/primera-division/2018/apertura/r45801/matches/ > ${DIR}/uru/a.html

#printf " %-3s > %-3s > %s > %s\n" "uru" "a" "primera-division" "clausura"
#${CURL} ${SW}/uruguay/primera-division/2018/clausura/r45804/matches/ > ${DIR}/uru/a.html

printf " %-3s > %-3s > %s > %s\n" "uru" "b" "segunda-division" "regular-season"
${CURL} ${SW}/uruguay/segunda-division/2018/regular-season/r45811/matches/ > ${DIR}/uru/b.html

