#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "chi" "a" "primera-division" "torneo-de-transicion"
${CURL} ${SW}/chile/primera-division/2018/torneo-de-transicion/r45895/matches/ > ${DIR}/chi/a.html

printf " %-3s > %-3s > %s > %s\n" "chi" "b" "primera-b" "regular-season"
${CURL} ${SW}/chile/primera-b/2018/regular-season/r45141/matches/ > ${DIR}/chi/b.html

printf " %-3s > %-3s > %s > %s\n" "chi" "c" "segunda-division" "regular-season"
${CURL} ${SW}/chile/segunda-division/2018/regular-season/r45856/matches/ > ${DIR}/chi/c.html

