#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "rus" "a" "premier-league" "regular-season"
${CURL} ${SW}/russia/premier-league/20172018/regular-season/r41733/matches/ > ${DIR}/rus/a.html

printf " %-3s > %-3s > %s > %s\n" "rus" "b" "1-division" "regular-season"
${CURL} ${SW}/russia/1-division/20172018/regular-season/r41576/matches/ > ${DIR}/rus/b.html

printf " %-3s > %-3s > %s > %s\n" "rus" "c1" "2-division" "west"
${CURL} ${SW}/russia/2-division/20172018/west/r42522/matches/ > ${DIR}/rus/c1.html

printf " %-3s > %-3s > %s > %s\n" "rus" "c2" "2-division" "center"
${CURL} ${SW}/russia/2-division/20172018/center/r42518/matches/ > ${DIR}/rus/c2.html

printf " %-3s > %-3s > %s > %s\n" "rus" "c3" "2-division" "south"
${CURL} ${SW}/russia/2-division/20172018/south/r42520/matches/ > ${DIR}/rus/c3.html

printf " %-3s > %-3s > %s > %s\n" "rus" "c4" "2-division" "ural-povolzhye"
${CURL} ${SW}/russia/2-division/20172018/ural-povolzhye/r42521/matches/ > ${DIR}/rus/c4.html

printf " %-3s > %-3s > %s > %s\n" "rus" "c5" "2-division" "east"
${CURL} ${SW}/russia/2-division/20172018/east/r42519/matches/ > ${DIR}/rus/c5.html

