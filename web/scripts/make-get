#!/bin/bash

SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"
COUNTRY=$1
SEASON=${2:-20222023}

echo '#!/bin/bash'
echo ''
echo 'SW="https://www.soccerway.com/national"'
echo 'DIR="/home/radu/rsssf/sat/web"'
echo ''

while read line
do
 read -a arr <<< ${line}
 URL="${SW}/${arr[0]}/${arr[1]}/${SEASON}/${arr[2]}/"
 REDIRECT=$(get-redirect ${URL})
 SOURCE=$(echo ${REDIRECT})
 SOURCE=$(echo ${REDIRECT} | sed -e 's|/national||g')
 echo 'printf "\n %-3s > %-3s > %s > %s" "'"${COUNTRY}"'" "'"${arr[3]}"'" "'"${arr[1]}"'" "'"${arr[2]}"'"'
 echo "curler " '"${SW}"'"${SOURCE}matches/" ' "${DIR}"/'"${COUNTRY}/${arr[3]}.html"
 echo ''
done < cfg/${COUNTRY}
