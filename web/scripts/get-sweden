#!/bin/bash

CURL="curl -s --get"
SW="http://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "swe" "a" "allsvenskan" "regular-season"
${CURL} ${SW}/sweden/allsvenskan/2017/regular-season/r39293/matches/ > ${DIR}/swe/a.html

printf " %-3s > %-3s > %s > %s\n" "swe" "b" "superettan" "regular-season"
${CURL} ${SW}/sweden/superettan/2017/regular-season/r39292/matches/ > ${DIR}/swe/b.html

printf " %-3s > %-3s > %s > %s\n" "swe" "c1" "division-1" "norra"
${CURL} ${SW}/sweden/division-1/2017/norra/r39857/matches/ > ${DIR}/swe/c1.html

printf " %-3s > %-3s > %s > %s\n" "swe" "c2" "division-1" "sodra"
${CURL} ${SW}/sweden/division-1/2017/sodra/r39858/matches/ > ${DIR}/swe/c2.html

