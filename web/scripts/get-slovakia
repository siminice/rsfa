#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "svk" "a" "super-liga" "regular-season"
${CURL} ${SW}/slovakia/super-liga/20172018/regular-season/r42021/matches/ > ${DIR}/svk/a.html

printf " %-3s > %-3s > %s > %s\n" "svk" "b" "i-liga" "west"
${CURL} ${SW}/slovakia/i-liga/20172018/west/r43078/matches/ > ${DIR}/svk/b.html

printf " %-3s > %-3s > %s > %s\n" "svk" "c1" "ii-liga" "bratislava"
${CURL} ${SW}/slovakia/ii-liga/20172018/bratislava/r42836/matches/ > ${DIR}/svk/c1.html

printf " %-3s > %-3s > %s > %s\n" "svk" "c2" "ii-liga" "west"
${CURL} ${SW}/slovakia/ii-liga/20172018/west/r42839/matches/ > ${DIR}/svk/c2.html

printf " %-3s > %-3s > %s > %s\n" "svk" "c3" "ii-liga" "center"
${CURL} ${SW}/slovakia/ii-liga/20172018/center/r42837/matches/ > ${DIR}/svk/c3.html

printf " %-3s > %-3s > %s > %s\n" "svk" "c4" "ii-liga" "east"
${CURL} ${SW}/slovakia/ii-liga/20172018/east/r42838/matches/ > ${DIR}/svk/c4.html

