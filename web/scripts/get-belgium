#!/bin/bash

CURL="curl -s --get"
SW="http://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "bel" "a" "pro-league" "play-offs-i"
${CURL} ${SW}/belgium/pro-league/20162017/play-offs-i/r36666/matches/ > ${DIR}/bel/a.html

printf " %-3s > %-3s > %s > %s\n" "bel" "a2" "uefa-europa-league-play-offs" "group-stage"
${CURL} ${SW}/belgium/uefa-europa-league-play-offs/20162017/group-stage/r37681/matches/ > ${DIR}/bel/a2.html

printf " %-3s > %-3s > %s > %s\n" "bel" "b2" "second-division" "relegation-round"
${CURL} ${SW}/belgium/second-division/20162017/relegation-round/r37469/matches/ > ${DIR}/bel/b2.html

printf " %-3s > %-3s > %s > %s\n" "bel" "c" "amateur-third-division" "regular-season"
${CURL} ${SW}/belgium/amateur-third-division/20162017/regular-season/r37630/matches/ > ${DIR}/bel/c.html

