#!/bin/bash

CURL="curl -s --get"
SW="http://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "per" "a" "primera-division" "clausura"
${CURL} ${SW}/peru/primera-division/2017/apertura/r40091/matches/ > ${DIR}/per/a.html

#printf " %-3s > %-3s > %s > %s\n" "per" "a" "primera-division" "clausura"
#${CURL} ${SW}/peru/primera-division/2017/clausura/r40091/matches/ > ${DIR}/per/a.html

printf " %-3s > %-3s > %s > %s\n" "per" "b" "segunda-division" "regular-season"
${CURL} ${SW}/peru/segunda-division/2017/regular-season/r39784/matches/ > ${DIR}/per/b.html

