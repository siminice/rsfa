#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "aze" "a" "premyer-liqa" "regular-season"
${CURL} ${SW}/azerbaijan/premyer-liqa/20172018/regular-season/r40864/matches/ > ${DIR}/aze/a.html

printf " %-3s > %-3s > %s > %s\n" "aze" "b" "birinci-dasta" "regular-season"
${CURL} ${SW}/azerbaijan/birinci-dasta/20172018/regular-season/r40857/matches/ > ${DIR}/aze/b.html

