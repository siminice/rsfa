#!/bin/bash

CURL="curl -s --get"
SW="http://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "den" "a1" "superliga" "championship-round"
${CURL} ${SW}/denmark/superliga/20162017/championship-round/r36803/matches/ > ${DIR}/den/a1.html

printf " %-3s > %-3s > %s > %s\n" "den" "a2" "superliga" "relegation-round"
${CURL} ${SW}/denmark/superliga/20162017/relegation-round/r36804/matches/ > ${DIR}/den/a2.html

printf " %-3s > %-3s > %s > %s\n" "den" "b" "1st-division" "regular-season"
${CURL} ${SW}/denmark/1st-division/20162017/regular-season/r36964/matches/ > ${DIR}/den/b.html

printf " %-3s > %-3s > %s > %s\n" "den" "c" "2nd-division" "promotion-round"
${CURL} ${SW}/denmark/2nd-division/20162017/promotion-round/r37612/matches/ > ${DIR}/den/c.html

printf " %-3s > %-3s > %s > %s\n" "den" "c4" "2nd-division" "relegation-round"
${CURL} ${SW}/denmark/2nd-division/20162017/relegation-round/r37613/matches/ > ${DIR}/den/c4.html

