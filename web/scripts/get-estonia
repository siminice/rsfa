#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "est" "a" "meistriliiga" "regular-season"
${CURL} ${SW}/estonia/meistriliiga/2018/regular-season/r44926/matches/ > ${DIR}/est/a.html

printf " %-3s > %-3s > %s > %s\n" "est" "b" "esiliiga" "regular-season"
${CURL} ${SW}/estonia/esiliiga/2018/regular-season/r44994/matches/ > ${DIR}/est/b.html

printf " %-3s > %-3s > %s > %s\n" "est" "c" "esiliiga-b" "regular-season"
${CURL} ${SW}/estonia/esiliiga-b/2018/regular-season/r44924/matches/ > ${DIR}/est/c.html

