#!/bin/bash

CURL="curl -s --get"
SW="http://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "cyp" "a1" "1-division" "championship-round"
${CURL} ${SW}/cyprus/1-division/20162017/championship-round/r35995/matches/ > ${DIR}/cyp/a1.html

printf " %-3s > %-3s > %s > %s\n" "cyp" "a2" "1-division" "relegation-round"
${CURL} ${SW}/cyprus/1-division/20162017/relegation-round/r35997/matches/ > ${DIR}/cyp/a2.html

printf " %-3s > %-3s > %s > %s\n" "cyp" "b" "2-division" "regular-season"
${CURL} ${SW}/cyprus/2-division/20162017/regular-season/r35051/matches/ > ${DIR}/cyp/b.html

printf " %-3s > %-3s > %s > %s\n" "cyp" "c" "3-division" "regular-season"
${CURL} ${SW}/cyprus/3-division/20162017/regular-season/r35509/matches/ > ${DIR}/cyp/c.html

