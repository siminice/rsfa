#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "ger" "a" "bundesliga" "regular-season"
${CURL} ${SW}/germany/bundesliga/20172018/regular-season/r41485/matches/ > ${DIR}/ger/a.html

printf " %-3s > %-3s > %s > %s\n" "ger" "b" "2-bundesliga" "regular-season"
${CURL} ${SW}/germany/2-bundesliga/20172018/regular-season/r41486/matches/ > ${DIR}/ger/b.html

printf " %-3s > %-3s > %s > %s\n" "ger" "c" "3-liga" "regular-season"
${CURL} ${SW}/germany/3-liga/20172018/regular-season/r41487/matches/ > ${DIR}/ger/c.html

printf " %-3s > %-3s > %s > %s\n" "ger" "d1" "regionalliga" "nord"
${CURL} ${SW}/germany/regionalliga/20172018/nord/r42355/matches/ > ${DIR}/ger/d1.html

printf " %-3s > %-3s > %s > %s\n" "ger" "d2" "regionalliga" "nordost"
${CURL} ${SW}/germany/regionalliga/20172018/nordost/r42356/matches/ > ${DIR}/ger/d2.html

printf " %-3s > %-3s > %s > %s\n" "ger" "d3" "regionalliga" "west"
${CURL} ${SW}/germany/regionalliga/20172018/west/r42359/matches/ > ${DIR}/ger/d3.html

printf " %-3s > %-3s > %s > %s\n" "ger" "d4" "regionalliga" "sudwest"
${CURL} ${SW}/germany/regionalliga/20172018/sudwest/r42358/matches/ > ${DIR}/ger/d4.html

printf " %-3s > %-3s > %s > %s\n" "ger" "d5" "regionalliga" "bayern"
${CURL} ${SW}/germany/regionalliga/20172018/bayern/r42354/matches/ > ${DIR}/ger/d5.html

