#!/bin/bash

CURL="curl -s --get"
SW="http://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "geo" "a" "umaglesi-liga" "regular-season"
${CURL} ${SW}/georgia/umaglesi-liga/2017/regular-season/r39831/matches/ > ${DIR}/geo/a.html

printf " %-3s > %-3s > %s > %s\n" "geo" "b" "pirveli-liga" "regular-season"
${CURL} ${SW}/georgia/pirveli-liga/2017/regular-season/r39854/matches/ > ${DIR}/geo/b.html

printf " %-3s > %-3s > %s > %s\n" "geo" "c" "meore-liga" "east"
${CURL} ${SW}/georgia/meore-liga/2017/east/r39753/matches/ > ${DIR}/geo/c.html

