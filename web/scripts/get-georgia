#!/bin/bash

CURL="curl -s --get"
SW="https://www.soccerway.com/national"
DIR="/home/radu/rsssf/sat/web"

printf " %-3s > %-3s > %s > %s\n" "geo" "a" "umaglesi-liga" "regular-season"
${CURL} ${SW}/georgia/umaglesi-liga/2018/regular-season/r45330/matches/ > ${DIR}/geo/a.html

printf " %-3s > %-3s > %s > %s\n" "geo" "b" "pirveli-liga" "regular-season"
${CURL} ${SW}/georgia/pirveli-liga/2018/regular-season/r45331/matches/ > ${DIR}/geo/b.html

printf " %-3s > %-3s > %s > %s\n" "geo" "c" "meore-liga" "regular-season"
${CURL} ${SW}/georgia/meore-liga/2018/regular-season/r45328/matches/ > ${DIR}/geo/c.html

