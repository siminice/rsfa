#!/bin/bash

  sed -e 's|,\([0-9][0-9]\)[/\.]\([0-9][0-9]\)[/\.]\([0-2][0-9][0-9][0-9]\),|,\3-\2-\1,|g' $1 > temp
  sed -e 's|,\([0-9]\)[/\.]\([0-9][0-9]\)[/\.]\([0-2][0-9][0-9][0-9]\),|,\3-\2-0\1,|g' temp > temp2
  sed -e 's|,\([0-9][0-9]\)[/\.]\([0-9]\)[/\.]\([0-2][0-9][0-9][0-9]\),|,\3-0\2-\1,|g' temp2 > temp
  sed -e 's|,\([0-9]\)[/\.]\([0-9]\)[/\.]\([0-2][0-9][0-9][0-9]\),|,\3-0\2-0\1,|g' temp > temp2

  sed -e 's|,\([0-9][0-9]\)[/\.]\([0-9][0-9]\)[/\.]\([0-9][0-9]\),|,19\3-\2-\1,|g' temp2 > temp
  sed -e 's|,\([0-9]\)[/\.]\([0-9][0-9]\)[/\.]\([0-9][0-9]\),|,19\3-\2-0\1,|g' temp > temp2
  sed -e 's|,\([0-9][0-9]\)[/\.]\([0-9]\)[/\.]\([0-9][0-9]\),|,19\3-0\2-\1,|g' temp2 > temp
  sed -e 's|,\([0-9]\)[/\.]\([0-9]\)[/\.]\([0-9][0-9]\),|,19\3-0\2-0\1,|g' temp > temp2

if [ $# -gt 1 ]
then
  mv temp2 $1
else
  cat temp2
fi

