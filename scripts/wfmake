#!/bin/bash
set WFLAGS="-Wno-invalid-source-encoding"

echo "g++ -g -c -o obj/wf-catalog.o src/wf-catalog.cc ..."
g++ $WFLAGS -g -c -o obj/catalog.o src/wf-catalog.cc

echo "g++ -g -c -o obj/aliases.o src/aliases.cc ..."
g++ $WFLAGS -g -c -o obj/aliases.o src/aliases.cc

echo "g++ -g -c -o obj/$1.o src/$1.cc ..."
g++ $WFLAGS -g -c -o obj/$1.o src/$1.cc

echo "g++ -g -o bin/$1 obj/$1.o obj/wf-catalog.o  ..."
g++ -g -o bin/$1 obj/$1.o obj/wf-catalog.o 
