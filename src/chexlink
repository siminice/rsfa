    ((unsigned char)Pl.P[i].mnem[2]),
    ((unsigned char)Pl.P[i].mnem[3]),
    ((unsigned char)Pl.P[i].mnem[4]),
    ((unsigned char)Pl.P[i].mnem[5]));
  hexlink[12]=0;
}
