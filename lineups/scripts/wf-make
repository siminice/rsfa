echo "g++ -g -o ~/lineups/bin/$1 ~/lineups/obj/$1.o ~/lineups/obj/wf-catalog.o"
g++ -g -o ~/lineups/bin/$1 ~/lineups/obj/$1.o ~/lineups/obj/wf-catalog.o
