#!/bin/bash

echo "g++ -g -c -o ~/lineups/obj/wf-catalog.o ~/lineups/src/wf-catalog.cc"
g++ -g -c -o ~/lineups/obj/wf-catalog.o ~/lineups/src/wf-catalog.cc
