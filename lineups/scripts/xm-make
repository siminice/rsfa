#!/bin/bash

echo "g++ -g -c -o ~/lineups/obj/xm-catalog.o ~/lineups/src/xm-catalog.cc"
g++ -g -c -o ~/lineups/obj/xm-catalog.o ~/lineups/src/xm-catalog.cc

echo "g++ -g -c -o ~/lineups/obj/$1.o ~/lineups/src/$1.cc"
g++ -g -c -o ~/lineups/obj/$1.o ~/lineups/src/$1.cc

echo "g++ -g -o ~/lineups/bin/$1 ~/lineups/obj/$1.o ~/lineups/obj/xm-catalog.o -lcurl"
g++ -g -o ~/lineups/bin/$1 ~/lineups/obj/$1.o ~/lineups/obj/xm-catalog.o -lcurl
