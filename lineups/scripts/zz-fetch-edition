COOKIE=$(zz-get-cookie)

URL="${HOST}/edition.php"

echo "Edition ${ED}"
curl -s --cookie "${COOKIE}" -d id_edicao=${ED} "${URL}" > ${OFILE}
grep zztable ${OFILE} > ${OFILE}.tmp
iconv -f ISO-8859-1 -t UTF-8 ${OFILE}.tmp > ${OFILE}
wc ${OFILE}

mv ed-${ED}.html tmp/${YEAR}
